{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 380,
  "height": 350,
  "title": "Running Participation Rate by State/Territory (%)",
  "projection": {
    "type": "mercator",
    "scale": 450,
    "center": [133.0, -27.0]
  },
  "data": {
    "url": "data/australia_states.topojson",
    "format": {
      "type": "topojson",
      "feature": "ne_10m_admin_1_states_provinces"
    }
  },
  "transform": [
    {
      "lookup": "properties.name",
      "from": {
        "data": {
          "url": "data/australia_state_running.csv"
        },
        "key": "State",
        "fields": ["Participation_Rate"]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "Participation_Rate",
      "type": "quantitative",
      "title": "Participation (%)",
      "scale": { "scheme": "greens" }
    },
    "tooltip": [
      {
        "field": "properties.name",
        "type": "nominal",
        "title": "State/Territory"
      },
      {
        "field": "Participation_Rate",
        "type": "quantitative",
        "title": "Participation Rate (%)"
      }
    ]
  },
  "config": {
    "view": { "stroke": null }
  }
}
