{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 380,
  "height": 350,
  "title": "Total Runners by State/Territory (Proportional Symbols)",
  "projection": {
    "type": "mercator",
    "scale": 450,
    "center": [133.0, -27.0]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e5e7eb",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/australia_state_runners.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.7,
        "color": "#1f77b4"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "runner_count",
          "type": "quantitative",
          "title": "Total Runners",
          "scale": { "range": [50, 1800] }
        },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State/Territory" },
          {
            "field": "runner_count",
            "type": "quantitative",
            "title": "Estimated Runners",
            "format": ","
          }
        ]
      }
    }
  ],
  "config": {
    "view": { "stroke": null }
  }
}
